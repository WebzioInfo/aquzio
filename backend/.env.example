# Aquora Backend Local Environment Variables Template
# Copy this file to .env and fill in your local dev credentials.
# NEVER commit the real .env file to version control.

# SMTP Configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-email@example.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=your-email@example.com
SMTP_FROM_NAME=Aquora
SMTP_ENABLE_SSL=true

# Database Connection
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=aquora_dev;Username=postgres;Password=postgres;

# JWT Authentication
JwtSettings__Secret=YourLocalSuperSecretKey123!
JwtSettings__Issuer=Aquora
JwtSettings__Audience=AquoraClients
JwtSettings__DurationInMinutes=60

# Biodrops Production External Integration API
# Required in production. Read-only API key for authorized external integration.
Integration__Biodrops__ApiKey=your_secure_integration_api_key_here
# Optional secondary key for seamless zero-downtime rotation
Integration__Biodrops__SecondaryApiKey=
# Optional comma-separated revoked SHA-256 fingerprints (legacy compromised key is auto-revoked by fingerprint)
Integration__Biodrops__RevokedKeys=
